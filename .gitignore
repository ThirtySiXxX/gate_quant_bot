# ============================================================
# 敏感信息
# ============================================================
# API Key/Secret 明文存储在这里
data/credentials.json
.env
*.key
*.pem
secrets.*

# 本机的实际配置：不含密钥，但包含运行模式(live/paper)、标的池、
# 调好的参数等个人设置。模板见 config.example.yaml。
config.yaml

# ============================================================
# 运行期产生的数据 —— 体积大且因人而异，不该进版本库
# ============================================================
# 注意写成 data/* 而不是 data/ —— git 不会递归进入被完全忽略的目录，
# 写成 data/ 的话下面那条 !data/.gitkeep 的例外规则就不会生效
data/*
!data/.gitkeep

# 具体包括（即使 data/ 规则改了也兜住）：
*.sqlite3
*.sqlite3-journal
*.db
data/klines/
data/backtests/
data/bot.log
*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境（170MB，且和操作系统/Python版本绑定）
venv/
.venv/
env/
ENV/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============================================================
# 编辑器 / 操作系统
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

scratch/
tmp/
*.tmp
